# Juno Voice frontend configuration.
#
# Copy to .env.local for local work (.env.local and .env are gitignored). Every
# VITE_ value below is baked into the browser bundle at build time, so nothing
# secret belongs in one; the only secret here (PINATA_JWT) is deliberately
# unprefixed and stays in the dev-server process.
#
# Required values fail closed: src/config.ts refuses to start on a missing or
# malformed deployment identity rather than guessing.

# --- Verified v2 deployment identity (required) ---------------------------

VITE_PROTOCOL_VERSION=v2
VITE_CHAIN_ID=juno-1

VITE_BOUNTY_CONTRACT_ADDRESS=juno1r4j8cpvd4e0t8p2hgyvnk5q2s2y8dpqd99ltymtkq99qq2j40waqph80dh
VITE_BOUNTY_CODE_ID=5155
VITE_BOUNTY_CODE_CHECKSUM=2d8265a9ce58d1057da3cea3b06c80d8dd89acf066e44073dd09008b3cd44ffa

VITE_REGISTRY_CONTRACT_ADDRESS=juno1f55krdtt936k9d5vel043gpe4axqyq7ysgk59j25ev0lxlzwkvxqsswx4t
VITE_REGISTRY_CODE_ID=5156
VITE_REGISTRY_CODE_CHECKSUM=513aa9264013e29c18007a85818ccfdbb1f3c4177d58cb4e13d9af3ae9d42a6a

VITE_VAULT_CONTRACT_ADDRESS=juno178famzzydmmyuqteu5g0vdhkrw53r6zatud5ap55xn7a95jeakssqjh8wt
VITE_VAULT_CODE_ID=5157
VITE_VAULT_CODE_CHECKSUM=3600206880f8f24ab867aac6b17b844b16a7b58712c5ca336a076bc13c98f2c0

VITE_VOTING_CONTRACT_ADDRESS=juno1w0spzqef0ypkv8v56jwmvewju63xarn5x6v3wy0wee49yu6r9z6s6a35sr
