VITE_GAUGE_CODE_CHECKSUM=b38915a07a79104768d37b109bb7c21517441a21802fec2b7a49c3fde4ae813d

# --- Network and release identity (required) ------------------------------

# Credential-free HTTPS Tendermint RPC. Read path only; it is the single
# required egress origin.
VITE_RPC_URL=https://juno-rpc.publicnode.com:443
# Only the Mintscan Juno explorer is accepted.
VITE_EXPLORER_URL=https://www.mintscan.io/juno
# Set by release automation to the exact reviewed commit; local builds may use local-uncommitted.
VITE_RELEASE_COMMIT=local-uncommitted
# Base path for the packaged review artifact (use / for local development).
VITE_BASE_PATH=/juno-voice/

# --- Metadata publishing and reading (optional) ---------------------------

# HTTPS IPFS gateway used to fetch and verify linked metadata documents.
# Default: https://ipfs.io/ipfs. Leave commented unless you want a different
# gateway: `npm run dev` swaps in its own local pin store when this is unset,
# and an explicit value stops locally pinned documents from resolving.
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs

# Presign endpoint for IPFS publishing (infra/pinata-presign-worker). Unset
# hides the upload flow and forms fall back to linking a file you published
# yourself. `npm run dev` fills this in with its own same-origin endpoint;
# set it to point somewhere else. HTTPS, http://127.0.0.1 for wrangler dev, or
# a same-origin path such as /api/presign/sign.
# VITE_PRESIGN_URL=https://presign.example/sign

# --- Public site metadata (optional, build time) --------------------------

# Origin the site is actually served from, scheme and host only, no path or
# trailing slash. When set, `npm run build` also emits canonical links, og:url,
# an absolute og:image, robots.txt, and sitemap.xml. Unset (the default today,
# since nothing is publicly hosted) those artifacts are skipped rather than
# written against a fabricated origin.
# VITE_CANONICAL_ORIGIN=https://voice.example

# --- Development only (.env.local, never committed) -----------------------

# Pinata credentials for `npm run dev`. With a JWT the dev server signs uploads
# through infra/pinata-presign-worker and pins for real; without one it pins to
# a local store under app/.dev-ipfs/ that only your machine can read. These are
# unprefixed on purpose: Vite exposes only VITE_ variables to the browser, so
# the JWT cannot reach a bundle. The deployed worker takes the same values as
# Cloudflare secrets, not from this file.
# PINATA_JWT=
# PINATA_GROUP_ID=
