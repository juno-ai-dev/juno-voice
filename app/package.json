{
  "name": "juno-voice-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "audit:all": "npm audit --audit-level=high",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "check:production": "node scripts/check-production.mjs dist",
    "verify": "npm run lint && npm run typecheck && npm test && npm run audit:all && npm run audit:production && npm run build && npm run check:production"
  },
  "dependencies": {
    "@cosmjs/encoding": "0.37.0",
    "cosmjs-types": "0.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.10.3",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
