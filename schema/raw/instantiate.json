    "steward",
    "submission_bond",
    "support_bps",
    "verifier",
    "voting_period_blocks",
    "work_inactivity_blocks"
  ],
  "properties": {
    "default_query_limit": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "evidence_policy_version": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "governor": {
