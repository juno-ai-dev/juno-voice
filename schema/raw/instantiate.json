    },
    "max_query_limit": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "max_reason_bytes": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "native_denom": {
      "type": "string"
    },
    "quorum_bps": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "request_limits": {
      "$ref": "#/definitions/RequestLimits"
    },
    "steward": {
      "type": "string"
    },
    "submission_bond": {
