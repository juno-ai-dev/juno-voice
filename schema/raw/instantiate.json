{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstantiateMsg",
  "type": "object",
  "required": [
    "default_query_limit",
    "evidence_policy_version",
    "governor",
    "max_query_limit",
    "max_reason_bytes",
    "native_denom",
    "quorum_bps",
