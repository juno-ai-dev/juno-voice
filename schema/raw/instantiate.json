    },
    "support_bps": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0.0
    },
    "verifier": {
      "type": "string"
    },
    "voting_period_blocks": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "work_inactivity_blocks": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "RequestLimits": {
      "type": "object",
      "required": [
        "max_acceptance_criteria_bytes",
        "max_attestation_evidence_refs",
        "max_category_bytes",
        "max_digest_bytes",
        "max_evidence_items",
        "max_evidence_note_bytes",
        "max_review_evidence_refs",
        "max_summary_bytes",
        "max_title_bytes",
        "max_uri_bytes"
      ],
      "properties": {
        "max_acceptance_criteria_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_attestation_evidence_refs": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_category_bytes": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_digest_bytes": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_evidence_items": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_evidence_note_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_review_evidence_refs": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_summary_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_title_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_uri_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
