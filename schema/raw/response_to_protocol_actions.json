{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolActionsResponse",
  "description": "A bounded ascending protocol-action-ID page. Pagination is weakly consistent while actions are appended; refresh page one to obtain a current view.",
  "type": "object",
  "required": [
    "items",
    "query_height"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProtocolActionRecord"
      }
    },
    "next_start_after": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "query_height": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Addr": {
      "description": "A human readable address.\n\nIn Cosmos, this is typically bech32 encoded. But for multi-chain smart contracts no assumptions should be made other than being UTF-8 encoded and of reasonable length.\n\nThis type represents a validated address. It can be created in the following ways 1. Use `Addr::unchecked(input)` 2. Use `let checked: Addr = deps.api.addr_validate(input)?` 3. Use `let checked: Addr = deps.api.addr_humanize(canonical_addr)?` 4. Deserialize from JSON. This must only be done from JSON that was validated before such as a contract's state. `Addr` must not be used in messages sent by the user because this would result in unvalidated instances.\n\nThis type is immutable. If you really need to mutate it (Really? Are you sure?), create a mutable copy using `let mut mutable = Addr::to_string()` and operate on that `String` instance.",
      "type": "string"
    },
    "FutureRequestPolicy": {
      "description": "Configuration copied into each newly opened request. Audit records retain both snapshots so later configuration changes cannot erase prior facts.",
      "type": "object",
      "required": [
        "quorum_bps",
        "request_limits",
        "submission_bond",
        "support_bps",
        "voting_period_blocks",
        "work_inactivity_blocks"
      ],
      "properties": {
        "quorum_bps": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "request_limits": {
          "$ref": "#/definitions/RequestLimits"
        },
        "submission_bond": {
          "$ref": "#/definitions/Uint128"
        },
        "support_bps": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "voting_period_blocks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "work_inactivity_blocks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ProtocolAction": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "submissions_paused",
            "submissions_unpaused"
          ]
        },
        {
          "type": "object",
          "required": [
            "config_updated"
          ],
          "properties": {
            "config_updated": {
              "type": "object",
              "required": [
                "new_policy",
                "old_policy"
              ],
              "properties": {
                "new_policy": {
                  "$ref": "#/definitions/FutureRequestPolicy"
                },
                "old_policy": {
                  "$ref": "#/definitions/FutureRequestPolicy"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "governor_proposed"
          ],
          "properties": {
            "governor_proposed": {
              "type": "object",
              "required": [
                "nominee"
              ],
              "properties": {
                "nominee": {
                  "$ref": "#/definitions/Addr"
                },
                "previous_nominee": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Addr"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "governor_transfer_cancelled"
          ],
          "properties": {
            "governor_transfer_cancelled": {
              "type": "object",
              "required": [
                "nominee"
              ],
              "properties": {
                "nominee": {
                  "$ref": "#/definitions/Addr"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "governor_accepted"
          ],
          "properties": {
            "governor_accepted": {
              "type": "object",
              "required": [
                "governor",
                "previous"
              ],
              "properties": {
                "governor": {
                  "$ref": "#/definitions/Addr"
                },
                "previous": {
                  "$ref": "#/definitions/Addr"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "steward_replaced"
          ],
          "properties": {
            "steward_replaced": {
              "type": "object",
              "required": [
                "previous",
                "steward"
              ],
              "properties": {
                "previous": {
                  "$ref": "#/definitions/Addr"
                },
                "steward": {
                  "$ref": "#/definitions/Addr"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "verifier_replaced"
          ],
          "properties": {
            "verifier_replaced": {
              "type": "object",
              "required": [
                "previous",
                "verifier"
              ],
              "properties": {
                "previous": {
                  "$ref": "#/definitions/Addr"
                },
                "verifier": {
                  "$ref": "#/definitions/Addr"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "migrated"
          ],
          "properties": {
            "migrated": {
              "type": "object",
              "required": [
                "from_version",
                "to_version"
              ],
              "properties": {
                "from_version": {
                  "type": "string"
                },
                "to_version": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "ProtocolActionRecord": {
      "type": "object",
      "required": [
        "action",
        "actor",
        "height",
        "id",
        "timestamp"
      ],
      "properties": {
        "action": {
          "$ref": "#/definitions/ProtocolAction"
        },
        "actor": {
          "$ref": "#/definitions/Addr"
        },
        "height": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "RequestLimits": {
      "type": "object",
      "required": [
        "max_acceptance_criteria_bytes",
        "max_attestation_evidence_refs",
        "max_category_bytes",
        "max_digest_bytes",
        "max_evidence_items",
        "max_evidence_note_bytes",
        "max_review_evidence_refs",
        "max_summary_bytes",
        "max_title_bytes",
        "max_uri_bytes"
      ],
      "properties": {
        "max_acceptance_criteria_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_attestation_evidence_refs": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_category_bytes": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_digest_bytes": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_evidence_items": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_evidence_note_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_review_evidence_refs": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0.0
        },
        "max_summary_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_title_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "max_uri_bytes": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "A point in time in nanosecond precision.\n\nThis type can represent times from 1970-01-01T00:00:00Z to 2554-07-21T23:34:33Z.\n\n## Examples\n\n``` # use cosmwasm_std::Timestamp; let ts = Timestamp::from_nanos(1_000_000_202); assert_eq!(ts.nanos(), 1_000_000_202); assert_eq!(ts.seconds(), 1); assert_eq!(ts.subsec_nanos(), 202);\n\nlet ts = ts.plus_seconds(2); assert_eq!(ts.nanos(), 3_000_000_202); assert_eq!(ts.seconds(), 3); assert_eq!(ts.subsec_nanos(), 202); ```",
      "allOf": [
        {
          "$ref": "#/definitions/Uint64"
        }
      ]
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    },
    "Uint64": {
      "description": "A thin wrapper around u64 that is using strings for JSON encoding/decoding, such that the full u64 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u64` to get the value out:\n\n``` # use cosmwasm_std::Uint64; let a = Uint64::from(42u64); assert_eq!(a.u64(), 42);\n\nlet b = Uint64::from(70u32); assert_eq!(b.u64(), 70); ```",
      "type": "string"
    }
  }
}
